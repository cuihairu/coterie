# Server
PORT=8080

# PostgreSQL
DATABASE_URL=postgres://coterie:coterie@localhost:5432/coterie?sslmode=disable

# Migrations (hand-written SQL is the schema source of truth)
MIGRATE_ON_START=true
MIGRATIONS_DIR=migrations

# Logging: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Outbound notification channels (FR-12, optional)
# Email via SMTP — disabled unless SMTP_HOST and SMTP_FROM are set
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=noreply@example.com

# Platform-level outbound webhook — POSTs every notification as JSON;
# body is HMAC-SHA256 signed with WEBHOOK_SECRET (X-Coterie-Signature)
#WEBHOOK_URL=
#WEBHOOK_SECRET=

# Payment channels registered on top of the always-on manual adapter
# (comma-separated; "sandbox" is the built-in offline demo channel)
#PAYMENT_METHODS=sandbox

# Provider plugins registered on top of the always-empty registry
# (comma-separated; "claude" is the built-in sample adding region/plan
# policy checks, admission guards, and usage caps to the seeded entry)
#PROVIDER_PLUGINS=claude

# Billing rollover scheduler cadence (design D13); "0" disables it
#AUTO_BILLING_INTERVAL=1h

# Rate limiting for the public auth endpoints, requests per client
# address per minute (design D19); 0 disables a limit.
#RATE_LIMIT_REGISTER_PER_MIN=5
#RATE_LIMIT_LOGIN_PER_MIN=10

# Web Push VAPID identity (design D22); all three set to enable the
# push channel. Keys are base64url: an uncompressed P-256 public point
# (65 bytes) and the raw 32-byte private scalar — generate with, e.g.:
#   go run ./cmd/vapidkeygen
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:ops@example.com

# Stripe payment channel (design D24). STRIPE_SECRET_KEY enables the
# "stripe" method (also list it in PAYMENT_METHODS); the webhook secret
# verifies Stripe's confirmations against the public webhook endpoint
# POST /api/v1/payments/webhooks/stripe. STRIPE_API_BASE overrides the
# API origin (testing).
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_API_BASE=https://api.stripe.com
