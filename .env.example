# Server
PORT=8080

# PostgreSQL
DATABASE_URL=postgres://coterie:coterie@localhost:5432/coterie?sslmode=disable

# Migrations (hand-written SQL is the schema source of truth)
MIGRATE_ON_START=true
MIGRATIONS_DIR=migrations

# Logging: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Outbound notification channels (FR-12, optional)
# Email via SMTP — disabled unless SMTP_HOST and SMTP_FROM are set
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=noreply@example.com

# Platform-level outbound webhook — POSTs every notification as JSON;
# body is HMAC-SHA256 signed with WEBHOOK_SECRET (X-Coterie-Signature)
#WEBHOOK_URL=
#WEBHOOK_SECRET=
